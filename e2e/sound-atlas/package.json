{
  "name": "sound-atlas-e2e",
  "private": true,
  "type": "module",
  "description": "Sound Atlas user-journey suite (tester-army e2e): deterministic journeys + feature gate + exploratory army with seeded-defect recall.",
  "scripts": {
    "bundle": "bash bundle.sh",
    "test": "E2E_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 e2e run --exclude-tag bugbash",
    "test:bugbash": "E2E_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 e2e run --tag bugbash",
    "gate": "node features-gate.mjs",
    "army": "bash run.sh",
    "army:boat": "bash boat/up.sh",
    "findings": "python3 findings.py runs"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.85",
    "@e2e-dev/web": "^0.15.5",
    "ai": "^7.0.163",
    "e2e": "^0.23.0",
    "playwright-core": "1.64.1",
    "zod": "^4.6.7"
  }
}
