{
  "name": "fframestudio",
  "private": true,
  "type": "module",
  "workspaces": [
    "bridge"
  ],
  "scripts": {
    "gen:smoke": "node tools/gen-smoke.mjs",
    "build:site": "python3 tools/build_demo_site.py",
    "example:fframes-intro": "python3 tools/example_fframes_intro.py",
    "verify:intro": "node tools/verify-intro.mjs",
    "verify:hosted": "node tools/verify-hosted.mjs",
    "verify:xplayer": "node tools/verify-xplayer.mjs",
    "bridge": "node bridge/bridge.mjs",
    "build:acp": "esbuild web/src/acp-client.mjs --bundle --format=esm --target=es2022 --minify --outfile=web/dist/acp-client.js",
    "test:acp": "node test/acp-e2e.mjs",
    "setup": "bash scripts/setup.sh",
    "doctor": "bash scripts/setup.sh --check",
    "test": "node --test test/generation/*.test.mjs test/doc/*.test.mjs test/theme/*.test.mjs test/hosted/*.test.mjs && npm run --silent test:procedural && node test/acp-e2e.mjs",
    "test:agents": "node test/acp-e2e.mjs claude codex hermes --edit claude",
    "import": "python3 tools/import_projects.py",
    "demo": "python3 tools/make_demo.py",
    "verify": "node test/verify.mjs",
    "test:doc": "node --test test/doc/*.test.mjs",
    "test:editor": "node tools/verify-editor.mjs",
    "test:editor-acp": "node tools/verify-editor.mjs --acp",
    "test:perf": "node --test --test-concurrency=1 test/perf/*.test.mjs && node tools/verify-editor.mjs --synthetic --perf",
    "test:procedural": "python3 -m unittest discover -s test -p 'test_procedural_fframes.py'"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.64.1"
  },
  "license": "Apache-2.0"
}
