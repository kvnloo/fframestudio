{
  "schema": "fframestudio.comfy-template/1",
  "id": "sdxl-base-t2i",
  "title": "SDXL base 1.0 · text to image",
  "kind": "image",
  "model": "stabilityai/stable-diffusion-xl-base-1.0",
  "description": "Classic KSampler graph. Pairs with the installed ControlNet Union SDXL ProMax for later structure-locked variants.",
  "vram": { "minimumFreeMiB": 7000, "measuredPeakMiB": null, "evidence": "Unmeasured on groot." },
  "licence": {
    "name": "CreativeML Open RAIL++-M",
    "url": "https://huggingface.co/stabilityai/stable-diffusion-xl-base-1.0/blob/main/LICENSE.md"
  },
  "params": {
    "width": { "minimum": 512, "maximum": 1536, "multipleOf": 8 },
    "height": { "minimum": 512, "maximum": 1536, "multipleOf": 8 },
    "steps": { "maximum": 60 },
    "batch": false
  },
  "workflow": {
    "4": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" } },
    "6": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["4", 1], "text": "cinematic still, soft rim light, 35mm film grain" } },
    "7": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["4", 1], "text": "blurry, watermark, text" } },
    "5": { "class_type": "EmptyLatentImage", "inputs": { "width": 1024, "height": 1024, "batch_size": 1 } },
    "3": { "class_type": "KSampler", "inputs": { "model": ["4", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0], "seed": 42, "steps": 25, "cfg": 7.0, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0 } },
    "8": { "class_type": "VAEDecode", "inputs": { "samples": ["3", 0], "vae": ["4", 2] } },
    "9": { "class_type": "SaveImage", "inputs": { "images": ["8", 0], "filename_prefix": "fframestudio/sdxl" } }
  }
}
